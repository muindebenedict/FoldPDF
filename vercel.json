{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "foldpdf.online"
        }
      ],
      "destination": "https://www.foldpdf.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://foldpdf.firebaseapp.com/__/auth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
