rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // No catch-all match. Firestore rules are OR-ed, so a
    // `match /{document=**} { allow read, write: if request.auth != null }`
    // hands every signed-in account full read/write over the whole database
    // and no later, narrower rule can take that back. Registration is open to
    // anyone, so that made support tickets and the mailing list world-readable.
    // Anything not matched below is denied.

    match /subscribers/{docId} {
      // Footer.tsx checks for an existing subscription with a
      // where("email","==",...) query. List rules are evaluated per returned
      // document, so restricting reads to the caller's own address lets that
      // query through while refusing a full dump of the list.
      allow read: if request.auth != null
                  && request.auth.token.email != null
                  && resource.data.email == request.auth.token.email.lower();

      allow create: if request.auth != null
                    && request.auth.token.email != null
                    && request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.subscribedAt == request.time;

      // Unsubscribing is an admin/backend action, not a client one.
      allow update, delete: if false;
    }

    match /support_tickets/{docId} {
      // Logged-out visitors must be able to file a ticket, so create stays
      // public -- but constrained, since Firestore has no rate limiting and
      // validation is the only lever available here.
      allow create: if request.resource.data.keys().hasOnly(
                         ['fullName', 'email', 'category', 'message', 'submittedAt', 'status'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 120
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.status == 'open'
                    && request.resource.data.submittedAt == request.time;

      // Tickets carry names, emails and free-text describing people's
      // documents. Nothing reads them back from the client; triage them in the
      // console or from a trusted backend.
      allow read, update, delete: if false;
    }
  }
}
